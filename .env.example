# =============================================================================
# TrocaFigurinha — Environment Variables
# =============================================================================
# Copy this file to .env.local for local development.
# NEVER commit .env.local or any file containing real secrets.
#
# Local development uses Cloud SQL Auth Proxy:
#   1. Install the Cloud SQL Auth Proxy binary locally
#   2. Run: gcloud auth application-default login
#   3. Start the proxy: cloud-sql-proxy --port 5432 PROJECT:REGION:INSTANCE
#   4. Set DATABASE_URL below to localhost
# =============================================================================

# --- Database ---
# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgres://postgres:password@localhost:5432/trocafigurinhas

# --- Auth.js (next-auth v5) ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-here
NEXTAUTH_URL=http://localhost:3000

# --- Google OAuth 2.0 ---
# Create at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URIs: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- GCloud (for deployment scripts) ---
GCLOUD_PROJECT_ID=trocafigurinhas-2026
GCLOUD_REGION=southamerica-east1
CLOUD_SQL_INSTANCE=trocafigurinhas-2026:southamerica-east1:trocafigurinhas-db
